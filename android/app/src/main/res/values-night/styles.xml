<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme for Night / Dark mode -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight">
        <item name="colorPrimary">#D02724</item>
        <item name="colorPrimaryDark">#D02724</item>
        <item name="colorAccent">#D02724</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">#D02724</item>
        <item name="android:navigationBarColor">#0D0D0D</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">#D02724</item>
        <item name="android:navigationBarColor">#0D0D0D</item>
    </style>
</resources>
